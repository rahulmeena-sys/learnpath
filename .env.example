# Copy to .env and fill in. .env is git-ignored.
# Postgres connection string. For Supabase, URL-encode special chars in the
# password (e.g. @ -> %40) and keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
NODE_ENV=development
PORT=8080
# Frontend dev server
BASE_PATH=/
# Optional: comma-separated CORS allowlist for the API (omit to allow all)
# CORS_ORIGIN=https://yourdomain.com

# Supabase Auth
# Server: derives the JWKS endpoint + token issuer for verifying auth JWTs.
SUPABASE_URL=https://your-project-ref.supabase.co
# Frontend (VITE_-prefixed → exposed to browser; anon key is public-safe).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Content pipeline (Phase 2)
# Anthropic API key for AI content generation (server-only).
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated admin emails allowed to use the content pipeline.
ADMIN_EMAILS=you@example.com
