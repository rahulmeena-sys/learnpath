# Copy to .env and fill in values. Get the real values from the team.
# .env is git-ignored — never commit it.

# Supabase project URL and public anon key (safe to expose in app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Postgres connection string — for setup-db script only (never bundled into app)
# URL-encode special chars in password: @ → %40, # → %23
DATABASE_URL=postgresql://postgres.your-project-ref:yourpassword@aws-region.pooler.supabase.com:5432/postgres
